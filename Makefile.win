# Project: fϵͳ1.0
# Makefile created by Red Panda C++ 3.4.3279

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-s" "-mwindows" "-lwinmm" "-limm32" "-static" "-ldxva2" "-ldxva2" "-luser32" "-lole32"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-std=c++17"
CFLAGS   = $(INCS) 
NASM_FLAGS   =  "-f" "elf64"
WINDRESFLAGS = 
RES      = f1.0_private.res
OBJ      = main.o $(RES)
BIN      = fϵͳ1.0.exe
LINKOBJ  = "main.o" "f1.0_private.res"
CLEANOBJ = "main.o" "f1.0_private.res" "fϵͳ1.0.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

fϵͳ1.0.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "fϵͳ1.0.exe" $(LIBS)

main.o: main.cpp
	$(CXX) -c "main.cpp" -o "main.o" $(CXXFLAGS)  -finput-charset=UTF-8 -fexec-charset=gbk

fϵͳ1.0_private.res: f1.0_private.rc f1.0_private.rc 
	$(WINDRES) -i "f1.0_private.rc" --input-format=rc -o "f1.0_private.res" -O coff $(WINDRESFLAGS) 

